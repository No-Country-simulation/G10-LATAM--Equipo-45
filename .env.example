# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el .env real.

# --- LLM / Embeddings (Google Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Tiempos máximos (segundos). Un timeout se traduce a un error normalizado (503 en Gemini/embeddings).
# GEMINI_TIMEOUT_S: plazo de cada solicitud. La librería reintenta una sola vez (no configurable), así que
#   el peor caso es ~2x este valor. GEMINI_TIMEOUT_TOTAL_S: tope de reloj de toda la generación.
GEMINI_TIMEOUT_S=45
GEMINI_TIMEOUT_TOTAL_S=100
# Tope de reloj de cada llamada de embeddings.
EMBEDDINGS_TIMEOUT_S=60

# --- RAG / Chunking ---
# El chunk final puede medir hasta CHUNK_SIZE + CHUNK_OVERLAP (el overlap se antepone al fragmento).
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Fragmentos del documento que se recuperan para armar el prompt del LLM.
TOP_K_RECUPERACION=8

# --- Verificación de fidelidad (NM-20) ---
# Por debajo de este score (0-1) la respuesta se marca como baja confianza (no se bloquea).
# Calibrado con scripts/calibrar_fidelidad.py sobre 12 casos fijos y una fuente de 2 fragmentos;
# conviene revisarlo con documentos reales. Detecta contenido fuera de tema, no datos inventados.
UMBRAL_ANCLAJE=0.72

# --- Vector store ---
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_COLLECTION=nuevamente_docs

# --- OCI Object Storage (Always Free) ---
OCI_BUCKET_NAME=
OCI_NAMESPACE=
OCI_REGION=sa-saopaulo-1
OCI_CONFIG_PROFILE=DEFAULT
# Timeouts del cliente de OCI (si vencen, se usa el fallback a disco).
OCI_CONNECT_TIMEOUT_S=5
OCI_READ_TIMEOUT_S=30
# Fallback a disco si OCI no está configurado o falla (los archivos quedan como pendiente_oci).
ALMACENAMIENTO_LOCAL_PATH=./data/almacenamiento_local

# --- API ---
# Tamaño máximo del archivo subido (o del texto pegado), en MB. Si lo supera: HTTP 413.
MAX_UPLOAD_MB=10
# Extensiones aceptadas, separadas por coma.
EXTENSIONES_PERMITIDAS=.pdf,.md,.txt

# --- Backend ---
APP_ENV=dev
# Nivel de log de la aplicación: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
